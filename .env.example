# Copy to .env in the application working directory.
HOST=127.0.0.1
PORT=4173
# DATA_DIR=data
# Set Secure only behind a HTTPS reverse proxy.
COOKIE_SECURE=0
# Optional periodic SQLite snapshot; download/archive backups to another disk.
BACKUP_INTERVAL_HOURS=24
# Optional teaching explanation gateway. POST {model,input}; returns {text}.
# Never put server credentials in frontend files.
# AI_GATEWAY_URL=https://your-service.example/explain
# AI_GATEWAY_KEY=
# AI_MODEL=default
